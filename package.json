{
  "name": "rsu-sdpo",
  "version": "1.0.0",
  "description": "Romblon State University Sports Development Program Office Transaction Management System and Equipment Inventory with QR Code Integration",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "nodemon server/app.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "storage:setup": "node server/scripts/setupSupabaseStorage.js",
    "test": "jest"
  },
  "keywords": [
    "rsu",
    "sdpo",
    "inventory",
    "qr-code",
    "capstone"
  ],
  "author": "Fernandez, Roxas, Fermanejo, Dioco, Fallaria",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "axios": "^1.7.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "qrious": "^4.0.2",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "jest": "^30.5.0",
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "bcrypt@6.0.0": true,
    "unrs-resolver@1.12.2": true
  }
}
