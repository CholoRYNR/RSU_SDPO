# Server
PORT=3000
NODE_ENV=development

# --- Database ---
# Supabase Postgres — used for every environment (dev and deployment alike).
# Get this from your Supabase project: Connect button (top of dashboard) ->
# Direct tab for the parameters, but use the SESSION POOLER host/port shown
# under Project Settings -> Database -> Connection pooling (the direct-
# connection host is IPv6-only and unreachable from most networks).
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Meta OAuth (optional)
META_CLIENT_ID=
META_CLIENT_SECRET=

# Email (Gmail SMTP - development)
GMAIL_SMTP_USER=
GMAIL_SMTP_PASS=

# Email (Brevo - production)
BREVO_API_KEY=

# SMS (Semaphore)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# File Uploads
MAX_UPLOAD_SIZE_MB=5

# --- File Storage (Supabase Storage) ---
# Borrower valid IDs / authorization documents are stored in a private
# Supabase Storage bucket, uploaded/downloaded server-side only via the
# service role key (never exposed to the browser).
# Get these from your Supabase project: Project Settings -> API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=borrower-documents
